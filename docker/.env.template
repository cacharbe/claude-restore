# =============================================================================
# .env.template -- copy this to .env and fill in real values
# NEVER commit .env to git -- it contains secrets
# =============================================================================

# --- Timezone ---
TIMEZONE=America/Chicago

# --- n8n ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_LOG_LEVEL=info

# REQUIRED: Generate a strong random key (stays the same across restarts
# or all stored credentials will be lost)
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REPLACE_WITH_YOUR_KEY

# --- Optional: expose n8n publicly (e.g. via ngrok or Cloudflare tunnel) ---
# N8N_HOST=your-domain.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://your-domain.com/
